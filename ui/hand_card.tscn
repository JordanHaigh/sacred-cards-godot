[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hand_card.gd" id="1_hand_card"]

[node name="HandCard" type="Button"]
custom_minimum_size = Vector2(152, 220)
toggle_mode = true
script = ExtResource("1_hand_card")

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 7

[node name="Column" type="VBoxContainer" parent="Content"]
